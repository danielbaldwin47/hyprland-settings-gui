{
  "@section:input": {
    "help_url": "https://wiki.hypr.land/Configuring/Variables/#input",
    "groups": [
      {
        "title": "Keyboard",
        "options": ["input:kb_layout", "input:kb_variant", "input:kb_options", "input:kb_model",
                    "input:kb_rules", "input:kb_file", "input:numlock_by_default",
                    "input:resolve_binds_by_sym", "input:repeat_rate", "input:repeat_delay"]
      },
      {
        "title": "Pointer",
        "description": "Applies to every pointing device unless a per-device override exists.",
        "options": ["input:sensitivity", "input:accel_profile", "input:scroll_points",
                    "input:force_no_accel", "input:left_handed", "input:rotation"]
      },
      {
        "title": "Scrolling",
        "options": ["input:natural_scroll", "input:scroll_factor", "input:scroll_method",
                    "input:scroll_button", "input:scroll_button_lock",
                    "input:emulate_discrete_scroll", "input:off_window_axis_events"]
      },
      {
        "title": "Focus follows mouse",
        "options": ["input:follow_mouse", "input:follow_mouse_threshold", "input:follow_mouse_shrink",
                    "input:mouse_refocus", "input:float_switch_override_focus",
                    "input:focus_on_close", "input:special_fallthrough"]
      },
      {
        "title": "Touchpad",
        "options": ["input:touchpad:tap-to-click", "input:touchpad:tap-and-drag",
                    "input:touchpad:tap_button_map", "input:touchpad:drag_lock",
                    "input:touchpad:clickfinger_behavior", "input:touchpad:middle_button_emulation",
                    "input:touchpad:natural_scroll", "input:touchpad:scroll_factor",
                    "input:touchpad:disable_while_typing", "input:touchpad:drag_3fg",
                    "input:touchpad:flip_x", "input:touchpad:flip_y"]
      },
      {
        "title": "Touchscreen",
        "options": ["input:touchdevice:enabled", "input:touchdevice:output", "input:touchdevice:transform"]
      },
      {
        "title": "Tablet",
        "options": ["input:tablet:output", "input:tablet:transform", "input:tablet:left_handed",
                    "input:tablet:relative_input", "input:tablet:region_position",
                    "input:tablet:absolute_region_position", "input:tablet:region_size",
                    "input:tablet:active_area_position", "input:tablet:active_area_size",
                    "input:tablettool:eraser_button_mode", "input:tablettool:eraser_button_override",
                    "input:tablettool:pressure_range_min", "input:tablettool:pressure_range_max"]
      },
      {
        "title": "Virtual keyboards",
        "options": ["input:virtualkeyboard:share_states", "input:virtualkeyboard:release_pressed_on_close"]
      }
    ]
  },

  "input:kb_layout": {"title": "Layout", "widget": "xkb-layout", "help": "XKB layout name, e.g. us, de, fr. Comma-separate to switch between several.", "known_values": ["us", "gb", "de", "fr", "es", "it", "se", "no", "dk", "pl", "cz", "ru", "br"], "help_url": "https://wiki.hypr.land/Configuring/Variables/#input"},
  "input:kb_variant": {"title": "Variant", "widget": "xkb-layout", "known_values": ["dvorak", "colemak", "intl", "nodeadkeys", "altgr-intl"], "nullable": true, "null_label": "Default", "help": "Layout variant, e.g. dvorak. Empty uses the layout's default."},
  "input:kb_options": {"title": "Options", "help": "XKB options, comma-separated, e.g. caps:escape,grp:alt_shift_toggle.", "nullable": true, "null_label": "None"},
  "input:kb_model": {"title": "Model", "nullable": true, "null_label": "Default", "visibility": "advanced"},
  "input:kb_rules": {"title": "Rules", "nullable": true, "null_label": "Default", "visibility": "advanced"},
  "input:kb_file": {"title": "Custom keymap file", "widget": "file-picker", "nullable": true, "null_label": "None", "visibility": "advanced", "help": "Path to a .xkb keymap. Overrides layout/variant/options."},
  "input:numlock_by_default": {"title": "Num Lock on at start"},
  "input:resolve_binds_by_sym": {"title": "Resolve keybinds by symbol", "help": "With several layouts, match binds against the produced symbol rather than the physical key."},
  "input:repeat_rate": {"title": "Key repeat rate", "unit": "/s", "help": "Repeats per second while a key is held."},
  "input:repeat_delay": {"title": "Key repeat delay", "unit": "ms", "help": "Delay before a held key starts repeating."},

  "input:sensitivity": {"title": "Sensitivity", "help": "Clamped to −1.0 … 1.0. 0 is the libinput default.", "range": {"min": -1.0, "max": 1.0}},
  "input:accel_profile": {"title": "Acceleration profile", "known_values": ["adaptive", "flat", "custom"], "labels": {"adaptive": "Adaptive", "flat": "Flat (no acceleration)", "custom": "Custom curve"}, "nullable": true, "null_label": "Device default"},
  "input:scroll_points": {"title": "Custom acceleration points", "depends_on": {"option": "input:accel_profile", "value": "custom"}, "help": "Space-separated points of the custom acceleration curve."},
  "input:force_no_accel": {"title": "Disable acceleration", "help": "Bypasses libinput's pointer acceleration entirely. Not recommended for most mice."},
  "input:left_handed": {"title": "Left-handed buttons", "help": "Swaps the left and right mouse buttons."},
  "input:rotation": {"title": "Device rotation", "unit": "deg"},

  "input:natural_scroll": {"title": "Natural scrolling"},
  "input:scroll_factor": {"title": "Scroll speed", "help": "Multiplier applied to external mouse scroll movement."},
  "input:scroll_method": {"title": "Scroll method", "known_values": ["2fg", "edge", "on_button_down", "no_scroll"], "labels": {"2fg": "Two fingers", "edge": "Edge", "on_button_down": "While holding a button", "no_scroll": "Disabled"}, "nullable": true, "null_label": "Device default"},
  "input:scroll_button": {"title": "Scroll button", "help": "evdev button code held for button scrolling. 0 keeps the device default.", "visibility": "advanced"},
  "input:scroll_button_lock": {"title": "Scroll button lock", "help": "Press once to start scrolling instead of holding the button."},
  "input:emulate_discrete_scroll": {"title": "Emulate discrete scroll"},
  "input:off_window_axis_events": {"title": "Scroll outside the focused window"},

  "input:follow_mouse": {"title": "Focus follows mouse"},
  "input:follow_mouse_threshold": {"title": "Movement threshold", "unit": "px", "depends_on": {"option": "input:follow_mouse", "value": 1}, "range": {"min": 0, "max": 200}, "help": "Distance the pointer must travel before focus follows it."},
  "input:follow_mouse_shrink": {"title": "Shrink inactive hitboxes", "unit": "px"},
  "input:mouse_refocus": {"title": "Refocus on mouse move"},
  "input:float_switch_override_focus": {"title": "Focus floating under cursor", "widget": "segmented", "labels": {"0": "Off", "1": "Tiled → floating", "2": "Also floating → floating"}},
  "input:focus_on_close": {"title": "Focus after closing a window"},
  "input:special_fallthrough": {"title": "Special workspace fallthrough"},

  "input:touchpad:tap-to-click": {"title": "Tap to click"},
  "input:touchpad:tap-and-drag": {"title": "Tap and drag"},
  "input:touchpad:tap_button_map": {"title": "Tap button map", "known_values": ["lrm", "lmr"], "labels": {"lrm": "1/2/3 fingers → left, right, middle", "lmr": "1/2/3 fingers → left, middle, right"}, "nullable": true, "null_label": "Device default"},
  "input:touchpad:drag_lock": {"title": "Drag lock", "widget": "segmented", "labels": {"0": "Disabled", "1": "Enabled (with timeout)", "2": "Sticky"}},
  "input:touchpad:clickfinger_behavior": {"title": "Clickfinger", "help": "Click with 1/2/3 fingers for left/right/middle instead of using click zones."},
  "input:touchpad:middle_button_emulation": {"title": "Middle-click emulation"},
  "input:touchpad:natural_scroll": {"title": "Natural scrolling"},
  "input:touchpad:scroll_factor": {"title": "Scroll speed"},
  "input:touchpad:disable_while_typing": {"title": "Disable while typing"},
  "input:touchpad:drag_3fg": {"title": "Multi-finger drag"},
  "input:touchpad:flip_x": {"title": "Flip horizontally", "visibility": "advanced"},
  "input:touchpad:flip_y": {"title": "Flip vertically", "visibility": "advanced"},

  "input:touchdevice:enabled": {"title": "Enable touchscreen"},
  "input:touchdevice:output": {"title": "Bound monitor", "widget": "monitor-picker", "nullable": true, "null_label": "Auto"},
  "input:touchdevice:transform": {"title": "Rotation", "widget": "segmented", "labels": {"0": "Normal", "1": "90°", "2": "180°", "3": "270°", "4": "Flipped", "5": "Flipped 90°", "6": "Flipped 180°"}},

  "input:tablet:output": {"title": "Bound monitor", "widget": "monitor-picker", "nullable": true, "null_label": "Auto"},
  "input:tablet:transform": {"title": "Rotation", "widget": "segmented", "labels": {"0": "Normal", "1": "90°", "2": "180°", "3": "270°", "4": "Flipped", "5": "Flipped 90°", "6": "Flipped 180°"}},
  "input:tablet:left_handed": {"title": "Rotate 180°"},
  "input:tablet:relative_input": {"title": "Relative input"},
  "input:tablet:region_position": {"title": "Mapped region position", "unit": "px", "range": {"min": -20000, "max": 20000}},
  "input:tablet:absolute_region_position": {"title": "Region position is absolute"},
  "input:tablet:region_size": {"title": "Mapped region size", "unit": "px", "range": {"min": -100, "max": 4000}},
  "input:tablet:active_area_position": {"title": "Active area position", "unit": "mm", "range": {"min": 0, "max": 500}},
  "input:tablet:active_area_size": {"title": "Active area size", "unit": "mm", "range": {"min": 0, "max": 500}},
  "input:tablettool:eraser_button_mode": {"title": "Eraser button", "widget": "segmented", "labels": {"0": "Hardware default", "1": "Send a button event"}},
  "input:tablettool:eraser_button_override": {"title": "Eraser button code", "depends_on": {"option": "input:tablettool:eraser_button_mode", "value": 1}, "range": {"soft_max": 600}, "visibility": "advanced"},
  "input:tablettool:pressure_range_min": {"title": "Minimum pressure", "nullable": true, "null_label": "Device default", "help": "A negative value keeps the tool's own range."},
  "input:tablettool:pressure_range_max": {"title": "Maximum pressure", "nullable": true, "null_label": "Device default"},

  "@section:decoration": {
    "help_url": "https://wiki.hypr.land/Configuring/Variables/#decoration",
    "groups": [
      {"title": "Windows", "options": ["decoration:rounding", "decoration:rounding_power",
                                        "decoration:active_opacity", "decoration:inactive_opacity",
                                        "decoration:fullscreen_opacity", "decoration:border_part_of_window"]},
      {"title": "Blur", "options": ["decoration:blur:enabled", "decoration:blur:size", "decoration:blur:passes",
                                     "decoration:blur:noise", "decoration:blur:contrast", "decoration:blur:brightness",
                                     "decoration:blur:vibrancy", "decoration:blur:vibrancy_darkness",
                                     "decoration:blur:xray", "decoration:blur:ignore_opacity",
                                     "decoration:blur:new_optimizations", "decoration:blur:special",
                                     "decoration:blur:popups", "decoration:blur:popups_ignorealpha",
                                     "decoration:blur:input_methods", "decoration:blur:input_methods_ignorealpha"]},
      {"title": "Shadow", "options": ["decoration:shadow:enabled", "decoration:shadow:range",
                                       "decoration:shadow:render_power", "decoration:shadow:sharp",
                                       "decoration:shadow:offset", "decoration:shadow:scale",
                                       "decoration:shadow:color", "decoration:shadow:color_inactive"]},
      {"title": "Glow", "options": ["decoration:glow:enabled", "decoration:glow:range",
                                     "decoration:glow:render_power", "decoration:glow:color",
                                     "decoration:glow:color_inactive"]},
      {"title": "Dimming", "options": ["decoration:dim_inactive", "decoration:dim_strength",
                                        "decoration:dim_modal", "decoration:dim_special", "decoration:dim_around"]},
      {"title": "Shaders", "options": ["decoration:screen_shader"]},
      {"title": "Motion blur", "options": ["decoration:motion_blur:enabled", "decoration:motion_blur:samples"]}
    ]
  },

  "decoration:rounding": {"title": "Corner radius", "unit": "px"},
  "decoration:rounding_power": {"title": "Corner roundness", "help": "2 is a circle; higher values give a squircle."},
  "decoration:active_opacity": {"title": "Active window opacity"},
  "decoration:inactive_opacity": {"title": "Inactive window opacity"},
  "decoration:fullscreen_opacity": {"title": "Fullscreen opacity"},
  "decoration:border_part_of_window": {"title": "Border counts as window", "visibility": "advanced"},
  "decoration:blur:enabled": {"title": "Blur window backgrounds"},
  "decoration:blur:size": {"title": "Blur size", "unit": "px", "depends_on": {"option": "decoration:blur:enabled", "value": true}},
  "decoration:blur:passes": {"title": "Blur passes", "depends_on": {"option": "decoration:blur:enabled", "value": true}, "help": "More passes look smoother and cost more GPU."},
  "decoration:blur:noise": {"title": "Noise"},
  "decoration:blur:contrast": {"title": "Contrast"},
  "decoration:blur:brightness": {"title": "Brightness"},
  "decoration:blur:vibrancy": {"title": "Vibrancy"},
  "decoration:blur:vibrancy_darkness": {"title": "Vibrancy in dark areas"},
  "decoration:blur:xray": {"title": "X-ray floating windows"},
  "decoration:blur:ignore_opacity": {"title": "Ignore window opacity"},
  "decoration:blur:new_optimizations": {"title": "Extra optimizations", "visibility": "advanced"},
  "decoration:blur:special": {"title": "Blur the special workspace", "help": "Expensive."},
  "decoration:blur:popups": {"title": "Blur popups"},
  "decoration:blur:popups_ignorealpha": {"title": "Popup alpha cutoff", "depends_on": {"option": "decoration:blur:popups", "value": true}},
  "decoration:blur:input_methods": {"title": "Blur input methods"},
  "decoration:blur:input_methods_ignorealpha": {"title": "Input method alpha cutoff", "depends_on": {"option": "decoration:blur:input_methods", "value": true}},
  "decoration:shadow:enabled": {"title": "Drop shadow"},
  "decoration:shadow:range": {"title": "Size", "unit": "px"},
  "decoration:shadow:render_power": {"title": "Falloff", "widget": "segmented", "labels": {"1": "Soft", "2": "Medium", "3": "Sharp", "4": "Sharpest"}},
  "decoration:shadow:sharp": {"title": "Hard edge"},
  "decoration:shadow:offset": {"title": "Offset", "unit": "px", "range": {"min": -250, "max": 250}},
  "decoration:shadow:scale": {"title": "Scale"},
  "decoration:shadow:color": {"title": "Colour"},
  "decoration:shadow:color_inactive": {"title": "Inactive colour", "nullable": true, "null_label": "Same as active"},
  "decoration:glow:enabled": {"title": "Inner glow"},
  "decoration:glow:range": {"title": "Size", "unit": "px"},
  "decoration:glow:render_power": {"title": "Falloff", "widget": "segmented", "labels": {"1": "Soft", "2": "Medium", "3": "Sharp", "4": "Sharpest"}},
  "decoration:glow:color": {"title": "Colour"},
  "decoration:glow:color_inactive": {"title": "Inactive colour", "nullable": true, "null_label": "Same as active"},
  "decoration:dim_inactive": {"title": "Dim inactive windows"},
  "decoration:dim_strength": {"title": "Dim strength", "depends_on": {"option": "decoration:dim_inactive", "value": true}},
  "decoration:dim_modal": {"title": "Dim parents of modals"},
  "decoration:dim_special": {"title": "Dim behind the special workspace"},
  "decoration:dim_around": {"title": "Dim for the dimaround rule"},
  "decoration:screen_shader": {"title": "Screen shader", "widget": "file-picker", "nullable": true, "null_label": "None", "visibility": "advanced"},
  "decoration:motion_blur:enabled": {"title": "Motion blur"},
  "decoration:motion_blur:samples": {"title": "Samples", "depends_on": {"option": "decoration:motion_blur:enabled", "value": true}},

  "@section:general": {
    "help_url": "https://wiki.hypr.land/Configuring/Variables/#general",
    "groups": [
      {"title": "Layout", "options": ["general:layout"]},
      {"title": "Gaps", "options": ["general:gaps_in", "general:gaps_out", "general:float_gaps", "general:gaps_workspaces"]},
      {"title": "Borders", "options": ["general:border_size", "general:col.active_border", "general:col.inactive_border",
                                        "general:col.nogroup_border_active", "general:col.nogroup_border",
                                        "general:resize_on_border", "general:extend_border_grab_area",
                                        "general:hover_icon_on_border"]},
      {"title": "Snapping", "options": ["general:snap:enabled", "general:snap:window_gap", "general:snap:monitor_gap",
                                         "general:snap:border_overlap", "general:snap:respect_gaps"]},
      {"title": "Behaviour", "options": ["general:resize_corner", "general:no_focus_fallback",
                                          "general:modal_parent_blocking", "general:allow_tearing", "general:locale"]}
    ]
  },

  "general:layout": {"title": "Tiling layout", "known_values": ["dwindle", "master", "scrolling", "monocle"], "labels": {"dwindle": "Dwindle", "master": "Master", "scrolling": "Scrolling", "monocle": "Monocle"}, "help": "Custom Lua layouts are addressed as lua:<name>."},
  "general:gaps_in": {"title": "Inner gaps", "unit": "px"},
  "general:gaps_out": {"title": "Outer gaps", "unit": "px"},
  "general:float_gaps": {"title": "Floating window gaps", "unit": "px", "nullable": true, "null_label": "Use outer gaps"},
  "general:gaps_workspaces": {"title": "Workspace gaps", "unit": "px"},
  "general:border_size": {"title": "Border width", "unit": "px"},
  "general:col.active_border": {"title": "Active border"},
  "general:col.inactive_border": {"title": "Inactive border"},
  "general:col.nogroup_border_active": {"title": "Active, cannot group", "visibility": "advanced"},
  "general:col.nogroup_border": {"title": "Inactive, cannot group", "visibility": "advanced"},
  "general:resize_on_border": {"title": "Resize by dragging borders"},
  "general:extend_border_grab_area": {"title": "Grab area", "unit": "px", "depends_on": {"option": "general:resize_on_border", "value": true}},
  "general:hover_icon_on_border": {"title": "Show resize cursor", "depends_on": {"option": "general:resize_on_border", "value": true}},
  "general:snap:enabled": {"title": "Snap floating windows"},
  "general:snap:window_gap": {"title": "Window snap distance", "unit": "px", "depends_on": {"option": "general:snap:enabled", "value": true}},
  "general:snap:monitor_gap": {"title": "Edge snap distance", "unit": "px", "depends_on": {"option": "general:snap:enabled", "value": true}},
  "general:snap:border_overlap": {"title": "Overlap borders when snapped", "depends_on": {"option": "general:snap:enabled", "value": true}},
  "general:snap:respect_gaps": {"title": "Respect gaps when snapping", "depends_on": {"option": "general:snap:enabled", "value": true}},
  "general:resize_corner": {"title": "Force resize corner"},
  "general:no_focus_fallback": {"title": "No focus fallback"},
  "general:modal_parent_blocking": {"title": "Modals block their parent"},
  "general:allow_tearing": {"title": "Allow tearing", "help": "Per-window tearing still needs an immediate window rule."},
  "general:locale": {"title": "Locale override", "nullable": true, "null_label": "System"}
}
